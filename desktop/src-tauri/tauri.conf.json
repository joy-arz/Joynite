{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Joynite",
  "version": "0.7.1",
  "identifier": "io.github.joy-arz.joynite.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Joynite",
        "width": 1440,
        "height": 900,
        "minWidth": 980,
        "minHeight": 660,
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Game",
    "shortDescription": "A redesigned, lightweight game-library carousel",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZEMTgzQjFBNDc4MTM4ODYKUldTR09JRkhHanNZYlpTZFVTR2R2YzM4bTF5eGtRMitSTldOL0wxS3pyTVc3SWpYTk9rRDR1K3cK",
      "endpoints": [
        "https://github.com/joy-arz/Joynite/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
